  "scripts": {
    "build": "npm run build:styles && npm run build:assets && npm run validate:styles && npm run validate:host-styles && npm run build:components",
    "build:styles": "rm -rf dist/css dist/fonts && mkdir -p dist/css dist/fonts && cp src/assets/styles/variables.css src/assets/styles/colors.generated.css src/assets/styles/rijksoverheid-fonts.css src/assets/styles/document-reset.css src/assets/styles/fouc.css dist/css/ && cp src/components/content/rich-text/rich-text.css src/components/forms/form/form.css src/components/forms/form-section/form-section.css dist/css/ && printf '@import \"./rijksoverheid-fonts.css\";\\n@import \"./variables.css\";\\n@import \"./document-reset.css\";\\n@import \"./rich-text.css\";\\n@import \"./form-section.css\";\\n@import \"./form.css\";\\n@import \"./fouc.css\";\\n' > dist/css/global.css && printf '@import \"./variables.css\";\\n@import \"./document-reset.css\";\\n@import \"./rich-text.css\";\\n@import \"./form-section.css\";\\n@import \"./form.css\";\\n@import \"./fouc.css\";\\n' > dist/css/global-system-font.css && printf '@import \"./rijksoverheid-fonts.css\";\\n@import \"./variables.css\";\\n' > dist/css/tokens.css && cp src/assets/fonts/*.woff2 dist/fonts/",
    "build:assets": "mkdir -p dist && cp src/assets/favicon/favicon.svg src/assets/favicon/touch-icon.png dist/",
    "generate:colors": "node scripts/generate-colors.js",
    "generate:component-reference": "node scripts/generate-component-reference.js",
    "generate:cem": "cem analyze && npm run generate:vue-types",
    "generate:vue-types": "node scripts/generate-vue-types.js",
    "generate:skill-changelog": "node scripts/generate-skill-changelog.js",
    "generate:skill-principles": "node scripts/generate-skill-principles.js",
    "generate:plugin-version": "node scripts/sync-plugin-version.js",
    "generate:publiccode": "node scripts/sync-publiccode.js",
    "generate:skill-docs": "npm run generate:component-reference && npm run generate:skill-changelog && npm run generate:skill-principles && npm run generate:plugin-version",
    "validate:styles": "node scripts/validate-css-variables.js",
    "validate:host-styles": "node scripts/validate-host-styles.js",
    "validate:component-api": "node scripts/validate-component-api.js",
    "build:components": "npm run clean:components && npm run build:icons && npm run build:components:modules && npm run build:components:bundle && npm run build:components:standalone && npm run build:exports && npm run generate:cem",
    "build:icons": "node scripts/generate-icon-registry.js && node scripts/generate-logo.js",
    "build:components:modules": "tsc -p tsconfig.build.json",
    "build:components:bundle": "vite build",
    "build:exports": "node scripts/generate-exports.js",
    "clean": "rm -rf dist",
    "clean:components": "rm -rf dist/components dist/nldd.min.js",
    "prestorybook": "npm run build:icons",
    "storybook": "storybook dev -p 6006",
    "sb:start": "node scripts/storybook-manager.js start",
    "sb:stop": "node scripts/storybook-manager.js stop",
    "sb:status": "node scripts/storybook-manager.js status",
    "sb:stop-all": "node scripts/storybook-manager.js stop-all",
    "prebuild-storybook": "npm run build:icons",
    "build-storybook": "storybook build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:a11y": "eslint src/ --rule 'lit-a11y/*: error'",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "prepare": "pre-commit install || true",
    "pretest": "npm run build:icons",
    "pretest:run": "npm run build:icons",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs scripts/lib/*.test.mjs",
    "pretypecheck": "npm run build:icons",
    "typecheck": "tsc --noEmit",
    "test:vue-types": "vue-tsc --noEmit -p type-tests/vue/tsconfig.json",
    "build:components:standalone": "vite build --config vite.bundle.config.ts"
  },
