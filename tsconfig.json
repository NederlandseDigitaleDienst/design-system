{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationDir": "dist/types",
    "sourceMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "storybook/actions": ["./site/client/shims/actions.ts"],
      "storybook/preview-api": ["./site/client/shims/preview-api.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "site/client/**/*.ts"],
  "exclude": ["node_modules", "dist", "site/.generated"]
}
